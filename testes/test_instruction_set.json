{
"Arithmetic_Logic":{
    "ADD": {
        "syntax": "ADD R0 R1",
        "number_of_args": 2,
        "behavior": "R0 = R0 + R1 * 4 / 2 + R7",
        "flags_modification": "(R0)?"
        },
    "SUB": {
        "syntax": "SUB R0 R1",
        "number_of_args": 2,
        "behavior": "R0 = R0 - R1 + 4 / 2 +",
        "flags_modification": "(R0)?"
        }
},
"Jumper":{
    "JMP": {
        "syntax": "JMP R0",
        "number_of_args": 1,
        "behavior": "PC = R0"
    }
},
"Conditional_Jumper":{
    "J": {
        "syntax": "J NEXT",
        "number_of_args": 1,
        "behavior": "PC = NEXT",
        "activation": "AND",
        "flags": {
            "a": {
                "true": "flags_register[0] == 1",
                "false":"flags_register[0] == 0"
            },
            "b": {
                "true": "flags_register[1] == 1",
                "false": "flags_register[1] == 0"
            }
        }
    },
    "J2": {
        "syntax": "J2 NEXT",
        "number_of_args": 1,
        "behavior": "PC = NEXT",
        "activation": "OR",
        "flags": {
            "c": {
                "true": "flags_register[0] == 1",
                "false":"flags_register[0] == 0"
            },
            "d": {
                "true": "flags_register[1] == 1",
                "false": "flags_register[1] == 0"
            }
        }
    }
},
"Data":{
    "LOAD": {
        "syntax": "LOAD R0 R1",
        "number_of_args": 2,
        "behavior": "R1 = MEMORY[R0]" 
        }
    }
}
